/// Author-written sidebar commentary. Drafts stay private until an admin
/// explicitly publishes them. The path is the same canonical Nuxt route used
/// by the workspace sheet, so notes work on games and ordinary site pages.
model TutorialNote {
  path          String    @id @db.VarChar(180)
  draftText     String    @db.Text
  publishedText String?   @db.Text
  publishedAt   DateTime?
  updatedAt     DateTime  @default(now()) @updatedAt
  updatedById   Int?

  @@index([updatedAt])
}
