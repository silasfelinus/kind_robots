// Kind Robots Arcade (conductor kr-arcade): three-initial high scores per
// cabinet. userId links a signed-in player without a relation so the User
// model stays untouched; username records that player's name as it was when
// the score was set (Silas, 2026-10-06), so the board shows who it was even if
// the account later changes or goes away. Guests have neither.

model ArcadeScore {
  id        Int      @id @default(autoincrement())
  gameSlug  String   @db.VarChar(64)
  initials  String   @db.VarChar(3)
  score     Int
  level     Int      @default(1)
  userId    Int?
  username  String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([gameSlug, score])
  @@index([gameSlug, createdAt])
  @@index([userId])
}

// One authenticated player's rating and editable comment per public Arcade title.
// Arcade games use stable slugs rather than database-backed entity IDs.
model ArcadeReview {
  id        Int      @id @default(autoincrement())
  gameSlug  String   @db.VarChar(64)
  userId    Int
  username  String?  @db.VarChar(255)
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameSlug, userId])
  @@index([gameSlug, rating])
}

// One logged-out visitor's star rating per public Arcade title (Silas,
// 2026-10-26, conductor interface-vision/t-150). voterHash is a SHA-256 of a
// random per-browser token, so no IP address, cookie value or user id is
// stored. Guest comments are held (commentHeld) until a moderator releases
// them; only the stars count toward the public average immediately.
model ArcadeGuestRating {
  id          Int      @id @default(autoincrement())
  gameSlug    String   @db.VarChar(64)
  voterHash   String   @db.VarChar(64)
  rating      Int
  comment     String?  @db.VarChar(280)
  commentHeld Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([gameSlug, voterHash])
  @@index([gameSlug, rating])
  @@index([voterHash, createdAt])
}
