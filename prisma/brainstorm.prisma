/// Durable private Brainstorm workspaces. `userId` is intentionally an indexed
/// ownership scalar rather than another back-relation on the already enormous
/// User model; authenticated API routes are the authority for owner scoping.
/// Nested creative state that has no independent query semantics is serialized
/// as JSON text in LongText columns, matching the repo's durable payload pattern.
model BrainstormSession {
  id              Int                  @id @default(autoincrement())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime?            @default(now()) @updatedAt
  userId          Int
  name            String               @db.VarChar(255)
  premise         String               @db.LongText
  resultCount     Int                  @default(8)
  constraints     String?              @db.LongText
  examples        String?              @db.LongText
  mode            String               @default("freeform") @db.VarChar(80)
  outputDomain    String               @default("ideas") @db.VarChar(40)
  batchShape      String               @default("focused") @db.VarChar(32)
  returnTypes     String?              @db.LongText
  source          String?              @db.LongText
  batches         String               @db.LongText
  activeBatchId   String?              @db.VarChar(200)
  lastGeneratedAt DateTime?
  isActive        Boolean              @default(true)
  Candidates      BrainstormCandidate[]

  @@index([userId, updatedAt])
  @@index([userId, isActive])
}

/// One durable row per application-owned Brainstorm candidate. `clientId`
/// remains the stable identity used by the workbench; revisions/meta stay
/// serialized because their ordering and lineage are meaningful as a whole.
model BrainstormCandidate {
  id             Int               @id @default(autoincrement())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime?         @default(now()) @updatedAt
  sessionId      Int
  clientId       String            @db.VarChar(200)
  batchId        String            @db.VarChar(200)
  position       Int               @default(0)
  title          String?           @db.VarChar(120)
  text           String            @db.LongText
  status         String            @default("pending") @db.VarChar(32)
  feedback       String?           @db.LongText
  edited         Boolean           @default(false)
  parentClientId String?           @db.VarChar(200)
  revisions      String            @db.LongText
  meta           String?           @db.LongText
  Session        BrainstormSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, clientId])
  @@index([sessionId, batchId, position])
  @@index([sessionId, status])
}

/// The social riff board at /play/brainstorm. A Riff is one table prompt
/// ("Terrible ice cream flavors", "Vanderbuilt Lacrosse…") that people answer
/// with Lines. `starterKey` marks the shared starter decks seeded from
/// utils/brainstormRiffs.ts; those rows have no owner (`userId` null).
/// `crossoverIds` is a JSON array of the persona riffs a crossover joins.
model BrainstormRiff {
  id           Int              @id @default(autoincrement())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime?        @default(now()) @updatedAt
  userId       Int?
  starterKey   String?          @unique @db.VarChar(80)
  flavor       String           @default("list") @db.VarChar(32)
  title        String           @db.VarChar(160)
  stem         String?          @db.VarChar(240)
  vibe         String?          @db.Text
  crossoverIds String?          @db.VarChar(200)
  isPublic     Boolean          @default(true)
  isOpen       Boolean          @default(true)
  lastLineAt   DateTime?
  Lines        BrainstormLine[]

  @@index([isPublic, lastLineAt])
  @@index([userId, updatedAt])
}

/// One human-written answer to a Riff. `authorName` is the display name on
/// the card (in table mode, the player at the table, not the account).
/// `aiSpark` records the coach spark that prompted the line, if any; the AI
/// never writes a Line. Art is attached through `artJobId` -> ArtJob.artImageId.
model BrainstormLine {
  id         Int            @id @default(autoincrement())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime?      @default(now()) @updatedAt
  riffId     Int
  userId     Int?
  authorName String         @db.VarChar(60)
  text       String         @db.VarChar(600)
  aiSpark    String?        @db.VarChar(240)
  artJobId   Int?
  artImageId Int?
  Riff       BrainstormRiff @relation(fields: [riffId], references: [id], onDelete: Cascade)
  Reactions  Reaction[]

  @@index([riffId, createdAt])
  @@index([userId])
}
