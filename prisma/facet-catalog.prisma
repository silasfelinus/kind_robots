// Canonical Facet catalog extensions.
//
// Facet remains the reusable creative concept. FacetProfile carries the richer
// taxonomy and randomization metadata without duplicating the concept row.
// CharacterFacet, BotFacet, and RewardFacet record how a Facet is used by a
// nested object; fieldKey is usage metadata, so one PERSONALITY Facet can shape
// either a Character or a Bot without duplicating the concept.

enum FacetTaxonomy {
  GENRE
  ANIMAL
  COLOR
  THEME
  CORE
  MOOD
  STYLE
  SETTING
  ART_DIRECTION
  SPECIES
  OCCUPATION
  ARCHETYPE
  ROLE
  ALIGNMENT
  GENDER
  // Embodiment axes (2026-09-15). Everything about a character's BODY was
  // previously unrolled vocabulary, so every generator that drew Facets got
  // rich genre/species/occupation variety over a body it had to invent
  // unaided -- and unaided bodies converge. Measured across all 98 authored
  // Daily Dream characters: 0% had a saturated hair colour, 0% had long hair,
  // 14.3% named an age, 9.2% named a skin tone, and she/her outnumbered
  // he/him 4.3 to 1. Every axis the seed plan rolled varied; every axis it
  // did not roll collapsed to one value.
  //
  // ORIGIN is culture, never phenotype, and it applies to non-humans too: a
  // walrus raised in a Lisbon-facing trade quarter wears that quarter's
  // oilcloth and swears by its saints. It does not have its people's
  // cheekbones. Humanoid complexion is DERIVED from ORIGIN by the author
  // rather than rolled from a standalone race table, which is the whole
  // reason there is no COMPLEXION value here.
  AGE
  BUILD
  HAIR
  ORIGIN
  BOT_TYPE
  DREAM_TYPE
  REWARD_TYPE
  RARITY
  PERSONALITY
  BACKSTORY
  QUIRK
  MATERIAL
  PROMPT_ENHANCEMENT
  OTHER
}

model FacetProfile {
  facetId          Int           @id
  taxonomy         FacetTaxonomy @default(OTHER)
  canonicalValue   String?       @db.VarChar(255)
  groupKey         String?       @db.VarChar(128)
  groupLabel       String?       @db.VarChar(255)
  sortOrder        Int           @default(0)
  isRandomizable   Boolean       @default(true)
  randomWeight     Float         @default(1)
  artRequired      Boolean       @default(true)
  sourceRank       Int           @default(100)
  metadata         String?       @db.LongText
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt

  @@index([taxonomy, groupKey, sortOrder])
  @@index([isRandomizable, taxonomy])
}

model CharacterFacet {
  id          Int       @id @default(autoincrement())
  characterId Int
  facetId     Int
  fieldKey    String    @db.VarChar(64)
  sortOrder   Int       @default(0)
  weight      Float     @default(1)
  source      String    @default("CURATED") @db.VarChar(64)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  Character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  Facet       Facet     @relation(fields: [facetId], references: [id], onDelete: Cascade)

  @@unique([characterId, facetId, fieldKey])
  @@index([characterId, fieldKey, sortOrder])
  @@index([facetId])
}

model BotFacet {
  id        Int      @id @default(autoincrement())
  botId     Int
  facetId   Int
  fieldKey  String   @db.VarChar(64)
  sortOrder Int      @default(0)
  weight    Float    @default(1)
  source    String   @default("CURATED") @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  Bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  Facet     Facet    @relation(fields: [facetId], references: [id], onDelete: Cascade)

  @@unique([botId, facetId, fieldKey])
  @@index([botId, fieldKey, sortOrder])
  @@index([facetId])
}

model RewardFacet {
  id        Int      @id @default(autoincrement())
  rewardId  Int
  facetId   Int
  fieldKey  String   @db.VarChar(64)
  sortOrder Int      @default(0)
  weight    Float    @default(1)
  source    String   @default("CURATED") @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  Reward    Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  Facet     Facet    @relation(fields: [facetId], references: [id], onDelete: Cascade)

  @@unique([rewardId, facetId, fieldKey])
  @@index([rewardId, fieldKey, sortOrder])
  @@index([facetId])
}
