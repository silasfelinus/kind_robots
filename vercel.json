{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "redirects": [
    {
      "source": "/images/:path*",
      "destination": "https://media.acrocatranch.com/images/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/images/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/*": true,
      "agent/*": false,
      "worker/*": false,
      "conductor/*": false
    }
  }
}
